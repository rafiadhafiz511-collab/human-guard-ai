# FastAPI Backend API Base URL
# Default: http://127.0.0.1:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# WebSocket URL for real-time device and automation updates
# Default: ws://localhost:8000/api/v1/ws/devices
VITE_WS_URL=ws://localhost:8000/api/v1/ws/devices

# App Environment
VITE_ENV=development
