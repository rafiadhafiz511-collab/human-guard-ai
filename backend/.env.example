# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5433/human_guard_ai
POSTGRES_DB=human_guard_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5433

# =====================================================
# REDIS CONFIGURATION
# =====================================================
REDIS_URL=redis://localhost:6379

# =====================================================
# SECURITY & JWT
# =====================================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =====================================================
# CORS & ALLOWED ORIGINS
# =====================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# =====================================================
# ENVIRONMENT & DEPLOYMENT
# =====================================================
ENVIRONMENT=development
DEBUG=true

# =====================================================
# FIREBASE (Optional - for push notifications)
# =====================================================
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# =====================================================
# MQTT BROKER (Optional - for device communication)
# =====================================================
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=user
MQTT_PASSWORD=password

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=INFO

# =====================================================
# API SETTINGS
# =====================================================
API_TITLE=Human Tech Smart Home Automation
API_VERSION=1.0.0
API_DESCRIPTION=Smart Pump Automation Backend with Real-time WebSocket Support
